{
  "name": "dice-cricket-online",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  // The built game, so one address can serve both the page and the rooms. Run `npm run build` in the repo root first.
  "assets": {
    "directory": "../dist",
    "run_worker_first": ["/rooms", "/rooms/*"]
  },
  "durable_objects": { "bindings": [{ "name": "ROOMS", "class_name": "Room" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Room"] }],
  // Creating rooms and opening connections, per person (IP address).
  "ratelimits": [
    { "name": "CREATE_LIMIT", "namespace_id": "1001", "simple": { "limit": 20, "period": 60 } },
    { "name": "JOIN_LIMIT", "namespace_id": "1002", "simple": { "limit": 60, "period": 60 } }
  ],
  "vars": {
    // Pages allowed to use the rooms, besides the one served from the same address.
    "ALLOWED_ORIGINS": "http://localhost:5173,http://localhost:5179"
  },
  "dev": { "port": 8787 }
}
